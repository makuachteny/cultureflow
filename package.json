{
  "name": "cultureflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-brand-svgs.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-brand-svgs.mjs",
    "build": "prisma generate && tsx scripts/build-demo-db.ts --if-demo && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "brand:build": "node scripts/build-brand-svgs.mjs",
    "brand:watch": "node scripts/watch-brand.mjs",
    "postinstall": "prisma generate",
    "demo:db": "tsx scripts/build-demo-db.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@electric-sql/pglite": "^0.2.17",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "next": "14.2.35",
    "next-auth": "5.0.0-beta.22",
    "pglite-prisma-adapter": "^0.3.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^17.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
