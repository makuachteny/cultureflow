# =============================================================
#  .env.example — copy to `.env` and fill in before boot.
#  NEVER commit `.env` itself (it's already in .gitignore).
# =============================================================

# ───────────────────────────── Required ─────────────────────────────

# Postgres connection string. In dev, matches docker-compose.yml.
DATABASE_URL="postgres://tribe:tribe@localhost:5432/tribe"

# NextAuth session-token secret. MUST be at least 32 bytes in production.
# Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=""

# Public-facing URL. In production MUST be https:// — the env module
# refuses to boot otherwise (NextAuth cookies require Secure + TLS).
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Display name surfaced in emails + OG metadata.
APP_NAME="NileTribe"

# Bootstraps an admin account at seed time. The user whose `email` matches
# this value gets `role = ADMIN` on first seed / first registration.
ADMIN_EMAIL="admin@example.com"

# ────────────────────────── Feature flags ──────────────────────────

# Paid ticket checkout. When true, at least ONE payment rail (Stripe,
# M-Pesa, MTN MoMo, m-Gurush) must be configured below or the env
# module will refuse to boot.
ENABLE_PAID_EVENTS="true"

# Social login. When true, GOOGLE_CLIENT_ID + SECRET are required.
ENABLE_SOCIAL_LOGIN="false"

# DEVELOPMENT ONLY — simulates paid checkout without real rails. Issues
# real tickets marked PAID. The env module refuses to boot in production
# with this set to true. Keep it unset (or false) on any non-dev deploy.
DEMO_CHECKOUT="false"

# Platform commission as a percentage (0..100). Snapshotted on each
# Order at creation time so historical revenue reporting stays correct
# if the policy changes.
PLATFORM_FEE_PERCENT="5"

# Cron secret — required header for /api/cron/sweep-reservations.
# Generate with `openssl rand -hex 32`. Set in your scheduler too.
CRON_SECRET=""

# ──────────────────────────── Stripe ─────────────────────────────
# Cards + Apple Pay + Google Pay (anywhere in the world).
# Get these from https://dashboard.stripe.com/apikeys.

STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─────────────────────── M-Pesa (Safaricom Daraja) ───────────────────
# For collections in KES via STK Push (Lipa Na M-Pesa Online).
# Sign up at https://developer.safaricom.co.ke/.
#
#   MPESA_ENV               "sandbox" or "production"
#   MPESA_CALLBACK_URL      public https URL of /api/webhooks/mpesa

MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL=""
# Optional shared secret added to the callback URL as `?t=<token>`.
# When set, the webhook handler rejects callers without the matching
# token. Generate with: openssl rand -hex 32
MPESA_CALLBACK_TOKEN=""

# ─────────────────────── MTN MoMo Collections ────────────────────────
# For collections in UGX, RWF, GHS, XAF, XOF, SSP via Request to Pay.
# Sign up at https://momodeveloper.mtn.com/.
#
#   MOMO_ENV          "sandbox" or "production"
#   MOMO_TARGET_ENV   the live MTN env you contracted with — one of:
#                       sandbox | mtnuganda | mtnrwanda | mtnghana
#                       mtncameroon | mtncoteivoire | mtnsouthsudan
#   MOMO_CALLBACK_URL public https URL of /api/webhooks/momo

MOMO_ENV="sandbox"
MOMO_TARGET_ENV="sandbox"
MOMO_SUBSCRIPTION_KEY=""
MOMO_API_USER_ID=""
MOMO_API_KEY=""
MOMO_CALLBACK_URL=""
MOMO_CALLBACK_TOKEN=""

# ────────────────────────── FX (currency conversion) ──────────────────
# Override to point at a paid feed (Open Exchange Rates / Fixer / Wise);
# default is the free https://exchangerate.host (no key required).
# FX_PROVIDER_URL=""
# FX_TTL_SECONDS="21600"

# ──────────────────────── m-Gurush (South Sudan) ─────────────────────
# Collections in SSP. Credentials issued at merchant onboarding by the
# m-Gurush commercial team — there's no public sign-up portal.

MGURUSH_ENV="sandbox"
MGURUSH_BASE_URL=""
MGURUSH_MERCHANT_ID=""
MGURUSH_API_KEY=""
MGURUSH_WEBHOOK_SECRET=""
MGURUSH_CALLBACK_URL=""

# ──────────────────────────── OAuth ──────────────────────────────
# Only required when ENABLE_SOCIAL_LOGIN=true.

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────── Email (TODO) ───────────────────────────
# Production needs a transactional email provider wired up for ticket
# receipts, refund confirmations, and password-reset flows. Until
# EMAIL_SERVER is set, these code paths silently skip their send step.

EMAIL_SERVER=""
EMAIL_FROM="NileTribe <hello@example.com>"

# ────────────────────────── Operations ──────────────────────────────

# Structured-logger minimum level. One of debug | info | warn | error.
# Production typically sits at "info"; bump to "warn" for noisy hosts.
LOG_LEVEL="info"

# Rate-limit backend. "memory" is per-process and resets on restart —
# fine for a single Node instance, undercount under multi-replica.
# Set to "redis" + provide REDIS_URL once you scale horizontally.
RATE_LIMIT_DRIVER="memory"
# REDIS_URL="redis://localhost:6379"

# When set to "true", the env module will refuse to boot if any
# production-only invariant is violated (DEMO_CHECKOUT, http://, weak
# secret, missing payment rail, etc.). Useful in CI to catch drift.
# Defaults to NODE_ENV === "production".
# STRICT_ENV_CHECKS="true"
